# Copy to .env and fill in. Nothing here is committed.

# --- ClickHouse Cloud: where the ad data lives and every figure is computed ---
CH_HOST=xxxxxxxx.ap-south-1.aws.clickhouse.cloud
CH_USER=default
CH_PASSWORD=
CH_DB=pw

# --- the LLM that writes the prose (and backs the chat agent) ---
DEEPSEEK_API_KEY=

# --- HyperDX / ClickStack ---
HYPERDX_URL=http://localhost:8080
HYPERDX_API_KEY=change-me
# A HyperDX Personal API Access Key: Team Settings -> API Keys, after first
# login. Cannot be minted at bootstrap, so it is set on a second pass.
HYPERDX_MCP_API_KEY=

# --- Langfuse ---
LANGFUSE_URL=http://localhost:3000
POSTGRES_PASSWORD=
MINIO_USER=minio
MINIO_PASSWORD=
LANGFUSE_NEXTAUTH_SECRET=
LANGFUSE_SALT=
LANGFUSE_ENCRYPTION_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Where a human opens a trace. Separate from ingestion, which uses localhost.
LANGFUSE_PUBLIC_URL=http://localhost:3000

# --- LibreChat ---
LIBRECHAT_CREDS_KEY=
LIBRECHAT_CREDS_IV=
LIBRECHAT_JWT_SECRET=
LIBRECHAT_JWT_REFRESH_SECRET=

# --- optional: closes the alert loop ---
GH_DISPATCH_PAT=
GH_REPO=ss-loves-AC/parts-watcher-2
